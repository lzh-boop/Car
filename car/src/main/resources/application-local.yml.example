# ============================================================================
# 本地开发配置模板
#
# 使用方法：
#   1) 把本文件复制一份并重命名为 application-local.yml（去掉 .example 后缀）
#   2) 填入您本地真实的密码、Key 等敏感值
#   3) 启动时通过 --spring.profiles.active=local 或环境变量
#      SPRING_PROFILES_ACTIVE=local 启用本地配置
#
# 重要：application-local.yml 已经在 .gitignore 中，不会被提交到 git
# ============================================================================

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/vehicle_gps?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&connectionCollation=utf8mb4_unicode_ci
    username: root
    password: 你的本地MySQL密码

  data:
    redis:
      host: localhost
      port: 6379
      database: 0
      password: 你的本地Redis密码（如无密码留空）

# 用 openssl rand -base64 32 生成一个随机字符串
jwt:
  secret: 你自己生成的JWT密钥（32字节 base64 编码）
  expiration: 86400000

# 到 https://console.amap.com/dev/key/app 申请
amap:
  web-service-key: 你自己申请的高德 Web 服务 Key
